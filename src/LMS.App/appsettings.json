{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "Database": {
    "Server": "<should-be-overriden>",
    "Name": "<should-be-overriden>",
    "Username": "<should-be-overriden>",
    "Password": "<should-be-overriden>",
    "Port": 5432
  },

  "MediaStorage": {
    "Endpoint": "<should-be-overriden>",
    "AccessKey": "<should-be-overriden>",
    "SecretKey": "<should-be-overriden>",
    "Bucket": "lms-media",
    "UseSsl": false,
    "PresignedUrlExpirationMinutes": 10,
    "MaxFileSizeMb": 100
  },
  
  "JwtAuth": {
    "Issuer": "<should-be-overriden>",
    "Audience": "<should-be-overriden>",
    "SigningKey": "<should-be-overriden>",
    "AccessTokenLifetimeInMinutes": 15,
    "RefreshTokenLifetimeInDays": 30
  },
  
  "OpenApi": {
    "EnableScalar": true
  }
}
